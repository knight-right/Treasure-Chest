filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("模板")'
    - '!file.inFolder("日记")'
formulas:
  部分: file.folder.split("/")[0]
properties:
  formula.部分:
    displayName: 部分
  file.name:
    displayName: 笔记
  type:
    displayName: 类型
  status:
    displayName: 状态
  updated:
    displayName: 更新日期
  file.folder:
    displayName: 位置
views:
  - type: table
    name: 进行中与待办
    filters:
      and:
        - status != null
        - status != "已完成"
    order:
      - file.name
      - type
      - status
      - updated
      - file.folder
  - type: table
    name: 面经进度
    filters:
      and:
        - type == "面经"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - updated
      - file.folder
  - type: table
    name: 最近修改
    order:
      - file.name
      - type
      - file.mtime
      - file.folder
    sort:
      - property: file.mtime
        direction: DESC
    limit: 20
  - type: table
    name: 全部笔记（按类型）
    filters:
      and:
        - type != "索引"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - status
      - tags
      - file.folder
  - type: table
    name: 按部分分组
    filters:
      and:
        - type != "索引"
        - file.folder != "/"
        - file.folder != ""
        - '!file.inFolder("参考资料")'
    groupBy:
      property: formula.部分
      direction: ASC
    order:
      - file.name
      - type
      - status
      - updated
      - file.folder
